# Server-only URL of the running KleeLab backend API.
# Set this in the frontend hosting environment; it is used by Next.js rewrites,
# so browser calls to /api/* reach the backend without any CORS setup.
#
# Local development: use http://localhost:8000 (put it in .env.local)
# Production:        use your deployed API origin, e.g. https://kleelab-dev.onrender.com
API_URL=http://localhost:8000

# Optional. Only set when the browser must call the API directly instead of
# proxying through Next.js. Leave empty to use API_URL + rewrites.
NEXT_PUBLIC_API_URL=
# The team dashboard (kleelab-admin). /admin on this site redirects there.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Shared secret the API sends when a portfolio item changes, so /portfolio shows
# it at once. Use the same value as REVALIDATE_SECRET in the backend. Unset, the
# portfolio still refreshes within five minutes.
REVALIDATE_SECRET=

# The public address of this site, with the www. The bare domain redirects to
# it, and search engines skip URLs that redirect. Unset, it is the www address.
NEXT_PUBLIC_SITE_URL=https://www.kleelab.com
# The code Google Search Console gives you to prove you own the site (the
# content="..." part of its HTML tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
