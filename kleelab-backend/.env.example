# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kleelab

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
# Short-lived access token; clients refresh it automatically.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# How long a refresh token stays valid. Rotated on every use.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Runtime
# development | production
ENVIRONMENT=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of the frontend, used in verification and reset emails.
FRONTEND_URL=http://localhost:3000
# Login/signup requests allowed per IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20
# Requests allowed per IP per hour for all other routes (the builder autosaves).
RATE_LIMIT_PER_HOUR=1000
# Local convenience only: mark new accounts email-verified immediately so that
# publishing works without a configured mail provider. Keep false in production.
AUTO_VERIFY_EMAILS=false
# Set to true to log every SQL statement.
SQL_ECHO=false

# Error monitoring (optional)
SENTRY_DSN=

# Email (optional for local development)
RESEND_API_KEY=
SENDGRID_FROM_EMAIL=noreply@kleelab.com

# Internal notifications (optional)
SLACK_WEBHOOK_URL=

# Rate limiting
# Optional shared store so limits hold across instances. Without it the limiter
# is per-process, which is only correct for a single worker.
REDIS_URL=
# Honour X-Forwarded-For / X-Real-IP. Required behind a load balancer, otherwise
# every caller shares the proxy's address and therefore one rate-limit bucket.
TRUST_PROXY=true

# Media uploads (Cloudinary)
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kleelab
MAX_UPLOAD_BYTES=5242880
