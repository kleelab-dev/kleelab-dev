# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kleelab

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
# Short-lived access token; clients refresh it automatically.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# How long a refresh token stays valid. Rotated on every use.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Runtime
# development | production
ENVIRONMENT=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of the frontend, used in emails such as password reset links.
FRONTEND_URL=http://localhost:3000
# Shared with the client site (its REVALIDATE_SECRET), so portfolio changes show
# on /portfolio at once. Unset, the site picks them up within five minutes.
REVALIDATE_SECRET=
# The team dashboard; staff password reset links point here.
ADMIN_URL=http://localhost:3001
# Replies to emails sent from the team dashboard go here (falls back to TEAM_INBOX).
REPLY_TO_EMAIL=
# Printed on invoice PDFs; separate lines with \n.
# INVOICE_FROM_ADDRESS=12 Example Street\nLagos, Nigeria
# INVOICE_PAYMENT_DETAILS=Bank: Example Bank\nAccount name: KleeLab\nAccount number: 0000000000
INVOICE_FROM_ADDRESS=
INVOICE_PAYMENT_DETAILS=
# Paystack card payments for invoices. Empty means off: no "Pay now" button and
# the payment routes answer 503. Use a test key (sk_test_...) until going live.
# Set the webhook URL in Paystack to {API}/api/payments/paystack/webhook.
PAYSTACK_SECRET_KEY=
# Where Paystack returns the client after paying. Empty means
# {FRONTEND_URL}/dashboard/payment.
PAYSTACK_CALLBACK_URL=
# Login/signup requests allowed per IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20
# Requests allowed per IP per hour for all other routes .
RATE_LIMIT_PER_HOUR=1000
# Visitor enquiry chat messages allowed per IP per hour (each one can call a paid model).
CHAT_RATE_LIMIT_PER_HOUR=60
# Set to true to log every SQL statement.
SQL_ECHO=false

# Error monitoring (optional)
SENTRY_DSN=

# Email (optional for local development)
# Mailtrap Email Sending token (used first when set), or Resend as a fallback.
MAILTRAP_API_TOKEN=
RESEND_API_KEY=
SENDGRID_FROM_EMAIL=noreply@kleelab.com
# Where enquiries, client messages and add-on requests are sent.
TEAM_INBOX=

# Internal notifications (optional)
SLACK_WEBHOOK_URL=

# Rate limiting
# Read the caller from X-Forwarded-For. Required behind a load balancer, otherwise
# every caller shares the proxy's address and therefore one rate-limit bucket.
TRUST_PROXY=true
# Proxies in front of the API that add to X-Forwarded-For (Render: Cloudflare + Render = 2).
TRUSTED_PROXY_HOPS=2

# Media uploads (Cloudinary)
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kleelab
MAX_UPLOAD_BYTES=5242880

# AI (the visitor enquiry chat)
# Fails closed. With AI_ENABLED=false, or with no key, the chat answers from
# written replies only. The server logs which of the two is missing at boot,
# because "off" and "broken" look identical from the interface.
AI_ENABLED=false
DEEPSEEK_API_KEY=
# DeepSeek speaks the OpenAI chat-completions dialect, so this is a base URL
# rather than a provider name. Swapping provider is a config change.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Google Gemini, reached through its OpenAI-compatible endpoint, so it needs no
# separate client and no second code path. DeepSeek is tried first and Gemini
# is the fallback. Either key alone is enough to run the chat — see the provider
# registry in services/llm.py.
#
# Note the path includes the API version. It is not api.generativelanguage...
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-pro
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4000
