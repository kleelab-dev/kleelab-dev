# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kleelab

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
# Short-lived access token; clients refresh it automatically.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# How long a refresh token stays valid. Rotated on every use.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Runtime
# development | production
ENVIRONMENT=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of the frontend, used in verification and reset emails, and as the
# fallback address for a published site when SITES_DOMAIN is not set.
FRONTEND_URL=http://localhost:3000
# The domain customer sites live under. Set this and a published site is advertised
# and reachable at https://{subdomain}.{SITES_DOMAIN}, which is also what the API
# accepts as a CORS origin. Leave it empty for local development: sites are then
# served from paths on FRONTEND_URL (/s/{subdomain}), which is the only form that
# works on a host with no subdomains.
#
# Setting this is not enough on its own. The frontend must be deployed somewhere
# with a hostname, and DNS needs a wildcard `*.{SITES_DOMAIN}` record plus a
# wildcard certificate. See the publishing section of the README.
SITES_DOMAIN=
# Login/signup requests allowed per IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20
# Requests allowed per IP per hour for all other routes (the builder autosaves).
RATE_LIMIT_PER_HOUR=1000
# Local convenience only: mark new accounts email-verified immediately so that
# publishing works without a configured mail provider. Keep false in production.
AUTO_VERIFY_EMAILS=false
# Set to true to log every SQL statement.
SQL_ECHO=false

# Error monitoring (optional)
SENTRY_DSN=

# Email (optional for local development)
RESEND_API_KEY=
SENDGRID_FROM_EMAIL=noreply@kleelab.com

# Internal notifications (optional)
SLACK_WEBHOOK_URL=

# Rate limiting
# Optional shared store so limits hold across instances. Without it the limiter
# is per-process, which is only correct for a single worker.
REDIS_URL=
# Honour X-Forwarded-For / X-Real-IP. Required behind a load balancer, otherwise
# every caller shares the proxy's address and therefore one rate-limit bucket.
TRUST_PROXY=true

# Media uploads (Cloudinary)
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=kleelab
MAX_UPLOAD_BYTES=5242880

# AI site builder
# Fails closed. With AI_ENABLED=false, or with no key, every /api/ai/* call is
# refused with a clear 503 and the start page offers a blank page instead. The
# server logs which of the two is missing at boot, because "off" and "broken"
# look identical from the interface. Nothing else in the product depends on this.
AI_ENABLED=false
DEEPSEEK_API_KEY=
# DeepSeek speaks the OpenAI chat-completions dialect, so this is a base URL
# rather than a provider name. Swapping provider is a config change.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_SECTIONS_PER_REQUEST=12
AI_MAX_PROMPT_CHARS=2000

# Placeholder photography
# Fills empty image slots so a generated site is not a page of empty frames.
# These are Unsplash-sourced photos picked by a stable seed, so they are real and
# consistent but NOT necessarily about the business: a bakery may get a mountain.
# They are placeholders to be replaced, not art direction. Set to false and image
# slots fall back to a designed on-brand placeholder instead.
STOCK_IMAGES_ENABLED=true
STOCK_IMAGE_BASE_URL=https://picsum.photos
STOCK_IMAGE_WIDTH=1400
STOCK_IMAGE_HEIGHT=1000
